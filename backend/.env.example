DEBUG=True
SECRET_KEY=kamalig-food-house-super-secret-dev-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configuration
# Set DB_ENGINE=postgresql and configure credentials below when connecting to PostgreSQL,
# or provide DATABASE_URL=postgres://user:password@localhost:5432/kamalig_db
DB_ENGINE=sqlite3
DB_NAME=kamalig_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kamalig_db

# CORS & Frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Cloudinary Storage (if CLOUDINARY_URL or CLOUDINARY_CLOUD_NAME is set, uses Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
